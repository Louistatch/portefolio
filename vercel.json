{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/elearning",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ww]hats[Aa]pp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|redditbot|Pinterestbot|SkypeUriPreview|vkShare|Embedly|Iframely).*"
        }
      ],
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "api/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/verify-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": "https://gcfcdkzmfybiigbnlwvb.supabase.co",

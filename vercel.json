{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "//regions": "dub1 = AWS eu-west-1, la région EXACTE de la base Supabase. Sans cette clé Vercel place les fonctions à iad1 (Washington) : chaque requête base traversait l'Atlantique, et nos routes enchaînent plusieurs allers-retours séquentiels. Dublin est aussi plus proche de l'Afrique de l'Ouest que Washington — le gain porte sur les deux trajets, ce n'est pas un arbitrage.",
  "regions": ["dub1"],
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/elearning",
      "destination": "/elearning.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "api/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/verify-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/late-warnings",
      "schedule": "30 9 * * *"
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": "https://gcfcdkzmfybiigbnlwvb.supabase.co",
